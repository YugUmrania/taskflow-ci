MONGO_URI=mongodb://localhost:27017/taskManagementDB
PORT=3000

# Practical 13 - AI integration (keep this file out of git!)
# The OpenAI SDK reads OPENAI_BASE_URL, so any OpenAI-compatible provider works
# without changing the code.

# Google Gemini (free) - https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.8-flash

# Groq (free) - https://console.groq.com/keys
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# OpenAI (paid)
# OPENAI_MODEL=gpt-4o-mini
